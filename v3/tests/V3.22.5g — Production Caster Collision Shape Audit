def audit_caster_dimensions(
    shape_data
):
    """
    Compare the runtime dimensions with the intended
    physical caster geometry.

    For a PyBullet cylinder:

        dimensions[0] = radius
        dimensions[1] = height
    """

    print_header(
        "CASTER DIMENSION CHECK"
    )

    if not shape_data:
        return False

    shape = shape_data[0]

    shape_type = shape[2]

    dimensions = shape[3]

    print()
    print(
        f"Runtime shape type = {shape_type}"
    )

    print(
        f"Runtime dimensions = {dimensions}"
    )

    if len(dimensions) < 2:

        print()
        print(
            "[FAIL] Collision dimensions are incomplete."
        )

        return False

    actual_radius = dimensions[0]
    actual_height = dimensions[1]

    print()
    print(
        "Expected:"
    )

    print(
        f"  Radius = "
        f"{EXPECTED_CASTER_RADIUS:.6f} m"
    )

    print(
        f"  Width  = "
        f"{EXPECTED_CASTER_WIDTH:.6f} m"
    )

    print()
    print(
        "Actual:"
    )

    print(
        f"  Radius = "
        f"{actual_radius:.6f} m"
    )

    print(
        f"  Height = "
        f"{actual_height:.6f} m"
    )

    radius_pass = almost_equal(
        actual_radius,
        EXPECTED_CASTER_RADIUS,
        tolerance=1e-6,
    )

    width_pass = almost_equal(
        actual_height,
        EXPECTED_CASTER_WIDTH,
        tolerance=1e-6,
    )

    print()
    print(
        f"Radius check = "
        f"{'PASS' if radius_pass else 'FAIL'}"
    )

    print(
        f"Width check  = "
        f"{'PASS' if width_pass else 'FAIL'}"
    )

    if radius_pass and width_pass:

        print()
        print(
            "[PASS] Production caster collision "
            "dimensions match the intended geometry."
        )

    else:

        print()
        print(
            "[FAIL] Production caster collision "
            "dimensions do NOT match the intended geometry."
        )

    return (
        radius_pass
        and width_pass
    )


