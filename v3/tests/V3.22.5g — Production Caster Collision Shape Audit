def import_production_robot():
    """
    Import robot.py as a module.

    This does not modify the source file.
    """

    print_header(
        "RUNTIME IMPORT AUDIT"
    )

    module_name = "production_robot_v3225g"

    spec = importlib.util.spec_from_file_location(
        module_name,
        ROBOT_FILE,
    )

    if spec is None:
        raise ImportError(
            "Could not create import specification "
            f"for {ROBOT_FILE}"
        )

    if spec.loader is None:
        raise ImportError(
            "Production robot.py has no import loader."
        )

    module = importlib.util.module_from_spec(
        spec
    )

    sys.modules[module_name] = module

    spec.loader.exec_module(module)

    print()
    print(
        "[PASS] robot.py imported successfully."
    )

    return module


