def audit_joint_hierarchy(robot_id):
    """
    Inspect the actual production joint hierarchy.
    """

    print_header(
        "RUNTIME JOINT HIERARCHY AUDIT"
    )

    num_joints = p.getNumJoints(
        robot_id
    )

    print()
    print(
        f"Number of joints = {num_joints}"
    )

    for joint_index in range(
        num_joints
    ):

        info = p.getJointInfo(
            robot_id,
            joint_index,
        )

        joint_name = info[1].decode(
            "utf-8",
            errors="replace",
        )

        joint_type = info[2]

        parent_index = info[16]

        axis = info[13]

        local_position = info[14]

        local_orientation = info[15]

        print()
        print(
            f"Joint {joint_index}:"
        )

        print(
            f"  Name              = "
            f"{joint_name}"
        )

        print(
            f"  Type              = "
            f"{joint_type}"
        )

        print(
            f"  Parent index      = "
            f"{parent_index}"
        )

        print(
            f"  Joint axis        = "
            f"{fmt_vector(axis)}"
        )

        print(
            f"  Local position    = "
            f"{fmt_vector(local_position)}"
        )

        print(
            f"  Local orientation = "
            f"{fmt_vector(local_orientation)}"
        )

    # --------------------------------------------------------
    # CASTER PARENT
    # --------------------------------------------------------

    if num_joints <= CASTER_LINK_INDEX:

        print()
        print(
            "[FAIL] Production robot does not "
            "have caster link index 3."
        )

        return False

    caster_info = p.getJointInfo(
        robot_id,
        CASTER_LINK_INDEX,
    )

    actual_parent = caster_info[16]

    actual_axis = caster_info[13]

    actual_position = caster_info[14]

    actual_orientation = caster_info[15]

    parent_pass = (
        actual_parent
        == EXPECTED_PARENT
    )

    axis_pass = vector_close(
        actual_axis,
        EXPECTED_CASTER_AXIS,
    )

    position_pass = vector_close(
        actual_position,
        EXPECTED_CASTER_LOCAL_POSITION,
    )

    expected_orientation = (
        p.getQuaternionFromEuler(
            EXPECTED_CASTER_ORIENTATION_EULER
        )
    )

    orientation_pass = vector_close(
        actual_orientation,
        expected_orientation,
        tolerance=1e-5,
    )

    print()
    print(
        "CASTER LINK CHECK"
    )

    print(
        f"  Expected parent = "
        f"{EXPECTED_PARENT}"
    )

    print(
        f"  Actual parent   = "
        f"{actual_parent}"
    )

    print(
        f"  Parent result    = "
        f"{'PASS' if parent_pass else 'FAIL'}"
    )

    print()
    print(
        f"  Expected axis = "
        f"{fmt_vector(EXPECTED_CASTER_AXIS)}"
    )

    print(
        f"  Actual axis   = "
        f"{fmt_vector(actual_axis)}"
    )

    print(
        f"  Axis result   = "
        f"{'PASS' if axis_pass else 'FAIL'}"
    )

    print()
    print(
        f"  Expected local position = "
        f"{fmt_vector(EXPECTED_CASTER_LOCAL_POSITION)}"
    )

    print(
        f"  Actual local position   = "
        f"{fmt_vector(actual_position)}"
    )

    print(
        f"  Position result         = "
        f"{'PASS' if position_pass else 'FAIL'}"
    )

    print()
    print(
        f"  Expected orientation = "
        f"{fmt_vector(expected_orientation)}"
    )

    print(
        f"  Actual orientation   = "
        f"{fmt_vector(actual_orientation)}"
    )

    print(
        f"  Orientation result   = "
        f"{'PASS' if orientation_pass else 'FAIL'}"
    )

    return (
        parent_pass
        and axis_pass
        and position_pass
        and orientation_pass
    )


