def read_robot_source():
    """Read robot.py without modifying it."""

    if not ROBOT_FILE.exists():
        raise FileNotFoundError(
            f"Production robot.py was not found:\n"
            f"{ROBOT_FILE}"
        )

    return ROBOT_FILE.read_text(
        encoding="utf-8"
    )


def get_source_lines():
    """Return robot.py source lines."""

    source = read_robot_source()

    return source.splitlines()


def source_audit():
    """
    Inspect robot.py using Python AST.

    This does not execute robot.py.
    """

    print_header(
        "V3.22.5g — SOURCE AUDIT"
    )

    print()
    print(
        f"Production file:\n"
        f"  {ROBOT_FILE}"
    )

    source = read_robot_source()

    try:
        tree = ast.parse(
            source,
            filename=str(ROBOT_FILE),
        )
    except SyntaxError as error:
        print()
        print("[FAIL] robot.py contains a syntax error.")
        print(
            f"  Line: {error.lineno}"
        )
        print(
            f"  Message: {error.msg}"
        )
        return {
            "syntax_ok": False,
            "cylinder_calls": [],
        }

    print()
    print("[PASS] robot.py syntax is valid.")

    lines = get_source_lines()

    cylinder_calls = []

    for node in ast.walk(tree):

        if not isinstance(
            node,
            ast.Call,
        ):
            continue

        # ----------------------------------------------------
        # Detect:
        #
        # p.createCollisionShape(...)
        #
        # ----------------------------------------------------

        function = node.func

        is_create_collision_shape = False

        if isinstance(
            function,
            ast.Attribute,
        ):
            if (
                function.attr
                == "createCollisionShape"
            ):
                is_create_collision_shape = True

        if not is_create_collision_shape:
            continue

        line_number = node.lineno

        end_line = (
            getattr(
                node,
                "end_lineno",
                line_number,
            )
        )

        source_fragment = "\n".join(
            lines[
                line_number - 1:
                end_line
            ]
        )

        values = {}

        # ----------------------------------------------------
        # Extract keyword values
        # ----------------------------------------------------

        for keyword in node.keywords:

            if keyword.arg is None:
                continue

            value = keyword.value

            if isinstance(
                value,
                ast.Constant,
            ):
                values[keyword.arg] = (
                    value.value
                )

            elif isinstance(
                value,
                ast.Name,
            ):
                values[keyword.arg] = (
                    value.id
                )

            elif isinstance(
                value,
                ast.Attribute,
            ):
                values[keyword.arg] = (
                    ast.unparse(value)
                )

            else:
                try:
                    values[keyword.arg] = (
                        ast.unparse(value)
                    )
                except Exception:
                    values[keyword.arg] = (
                        "<expression>"
                    )

        # ----------------------------------------------------
        # Extract first positional argument
        # ----------------------------------------------------

        geometry_type = None

        if node.args:

            first_arg = node.args[0]

            try:
                geometry_type = ast.unparse(
                    first_arg
                )
            except Exception:
                geometry_type = "<expression>"

        cylinder_calls.append(
            {
                "line": line_number,
                "end_line": end_line,
                "geometry_type": geometry_type,
                "values": values,
                "source": source_fragment,
            }
        )

    print()
    print(
        f"Detected createCollisionShape calls: "
        f"{len(cylinder_calls)}"
    )

    for index, call in enumerate(
        cylinder_calls,
        start=1,
    ):

        print()
        print(
            f"[Collision Shape {index}]"
        )

        print(
            f"  Lines: "
            f"{call['line']}"
            f"-{call['end_line']}"
        )

        print(
            f"  Geometry: "
            f"{call['geometry_type']}"
        )

        values = call["values"]

        if "radius" in values:
            print(
                f"  radius = "
                f"{values['radius']}"
            )

        if "height" in values:
            print(
                f"  height = "
                f"{values['height']}"
            )

        if "collisionFrameOrientation" in values:
            print(
                "  collisionFrameOrientation = "
                f"{values['collisionFrameOrientation']}"
            )

        print()
        print("  Source:")
        print(
            "  "
            + call["source"].replace(
                "\n",
                "\n  ",
            )
        )

    return {
        "syntax_ok": True,
        "cylinder_calls": cylinder_calls,
    }


