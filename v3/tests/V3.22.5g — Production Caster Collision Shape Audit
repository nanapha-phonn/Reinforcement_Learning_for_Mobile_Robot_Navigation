def print_header(title):
    print()
    print("=" * 80)
    print(title)
    print("=" * 80)


def print_subheader(title):
    print()
    print("-" * 70)
    print(title)
    print("-" * 70)


def fmt_vector(values):
    return "(" + ", ".join(
        f"{value:.9f}"
        for value in values
    ) + ")"


def almost_equal(a, b, tolerance=1e-6):
    return abs(a - b) <= tolerance


def vector_close(a, b, tolerance=1e-6):
    if len(a) != len(b):
        return False

    return all(
        almost_equal(x, y, tolerance)
        for x, y in zip(a, b)
    )


