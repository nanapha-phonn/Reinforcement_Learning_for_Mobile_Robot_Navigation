def audit_static_state(robot_id):
    """
    Let production robot settle and inspect its static state.
    """

    print_header(
        "STATIC PRODUCTION CONTACT AUDIT"
    )

    # Stop production motors if available.
    #
    # The caller handles the function externally when possible.

    for _ in range(
        SETTLE_STEPS
    ):
        p.stepSimulation()

    base_position, base_orientation = (
        p.getBasePositionAndOrientation(
            robot_id
        )
    )

    base_euler = p.getEulerFromQuaternion(
        base_orientation
    )

    pitch = math.degrees(
        base_euler[1]
    )

    roll = math.degrees(
        base_euler[0]
    )

    caster_contacts = p.getContactPoints(
        bodyA=robot_id,
        bodyB=0,
        linkIndexA=CASTER_LINK_INDEX,
    )

    caster_force = sum(
        contact[9]
        for contact in caster_contacts
    )

    print()
    print(
        f"Base position = "
        f"{fmt_vector(base_position)}"
    )

    print(
        f"Base roll     = "
        f"{roll:.6f} deg"
    )

    print(
        f"Base pitch    = "
        f"{pitch:.6f} deg"
    )

    print(
        f"Caster contacts = "
        f"{len(caster_contacts)}"
    )

    print(
        f"Caster normal force = "
        f"{caster_force:.6f} N"
    )

    base_height_pass = almost_equal(
        base_position[2],
        EXPECTED_BASE_Z,
        tolerance=0.002,
    )

    attitude_pass = (
        abs(roll) < 0.5
        and abs(pitch) < 0.5
    )

    contact_pass = (
        len(caster_contacts) > 0
        and caster_force > 0.1
    )

    print()
    print(
        f"Base Z check = "
        f"{'PASS' if base_height_pass else 'INVESTIGATE'}"
    )

    print(
        f"Attitude check = "
        f"{'PASS' if attitude_pass else 'INVESTIGATE'}"
    )

    print(
        f"Caster contact check = "
        f"{'PASS' if contact_pass else 'INVESTIGATE'}"
    )

    return (
        base_height_pass
        and attitude_pass
        and contact_pass
    )


# ============================================================
# SOURCE-LEVEL CASTER CANDIDATE ANALYSIS
# ============================================================

def identify_caster_candidates(
    source_result
):
    """
    Identify cylinder calls that could be the caster.

    This is intentionally conservative.

    We do NOT automatically modify or reinterpret robot.py.
    """

    print_header(
        "SOURCE CASTER CANDIDATE ANALYSIS"
    )

    candidates = []

    for call in source_result[
        "cylinder_calls"
    ]:

        values = call["values"]

        radius = values.get(
            "radius"
        )

        height = values.get(
            "height"
        )

        if radius is None or height is None:
            continue

        # Compare against known caster dimensions.
        radius_matches_caster_width = (
            isinstance(radius, (int, float))
            and almost_equal(
                float(radius),
                EXPECTED_CASTER_WIDTH,
                tolerance=1e-9,
            )
        )

        height_matches_caster_radius = (
            isinstance(height, (int, float))
            and almost_equal(
                float(height),
                EXPECTED_CASTER_RADIUS,
                tolerance=1e-9,
            )
        )

        radius_matches_caster_radius = (
            isinstance(radius, (int, float))
            and almost_equal(
                float(radius),
                EXPECTED_CASTER_RADIUS,
                tolerance=1e-9,
            )
        )

        height_matches_caster_width = (
            isinstance(height, (int, float))
            and almost_equal(
                float(height),
                EXPECTED_CASTER_WHEEL_WIDTH,
                tolerance=1e-9,
            )
        )

        if (
            radius_matches_caster_width
            and height_matches_caster_radius
        ):
            classification = (
                "POSSIBLE CASTER RADIUS/WIDTH SWAP"
            )

            candidates.append(
                call
            )

        elif (
            radius_matches_caster_radius
            and height_matches_caster_width
        ):
            classification = (
                "MATCHES INTENDED CASTER GEOMETRY"
            )

            candidates.append(
                call
            )

        else:
            classification = (
                "NOT AN OBVIOUS CASTER MATCH"
            )

        print()
        print(
            f"Lines {call['line']}-"
            f"{call['end_line']}: "
            f"{classification}"
        )

        print(
            f"  radius = {radius}"
        )

        print(
            f"  height = {height}"
        )

    if not candidates:

        print()
        print(
            "No obvious caster cylinder candidate "
            "was identified automatically."
        )

    return candidates


